<mxfile host="build_diagram.py"><diagram name="Lock decision" id="lock-decision"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Which workspace lock does a call take?" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1120" height="40" as="geometry"/></mxCell><mxCell id="lane_caller" value="Request" style="swimlane;html=1;startSize=44;fillColor=#E8F5E9;strokeColor=#43A047;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="280" height="824" as="geometry"/></mxCell><mxCell id="lane_conn" value="Connector decides" style="swimlane;html=1;startSize=44;fillColor=#E3F2FD;strokeColor=#1E88E5;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="280" height="824" as="geometry"/></mxCell><mxCell id="lane_none" value="No lock" style="swimlane;html=1;startSize=44;fillColor=#F5F5F5;strokeColor=#757575;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="280" height="824" as="geometry"/></mxCell><mxCell id="lane_lock" value="Lock taken" style="swimlane;html=1;startSize=44;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="840" y="0" width="280" height="824" as="geometry"/></mxCell><mxCell id="r0" value="Action call&lt;br&gt;URL + payload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35.0" y="74.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="d1" value="get, workspace off,&lt;br&gt;exempt URL or&lt;br&gt;auto_lock_ws?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325.0" y="182.0" width="190" height="100" as="geometry"/></mxCell><mxCell id="n1" value="Run unlocked&lt;br&gt;(log says why)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#F5F5F5;strokeColor=#757575;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595.0" y="194.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="d2" value="ADOM&lt;br&gt;resolved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325.0" y="302.0" width="190" height="100" as="geometry"/></mxCell><mxCell id="n2" value="Run unlocked&lt;br&gt;+ WARNING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#F5F5F5;strokeColor=#757575;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595.0" y="314.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="d4" value="Minimal locking,&lt;br&gt;not global, device DB&lt;br&gt;or onboarding?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325.0" y="422.0" width="190" height="100" as="geometry"/></mxCell><mxCell id="ladom" value="ADOM lock&lt;br&gt;(global ADOM:&lt;br&gt;global lock)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875.0" y="434.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="d5" value="Package or device&lt;br&gt;resolved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325.0" y="542.0" width="190" height="100" as="geometry"/></mxCell><mxCell id="lscope" value="pkg/&amp;lt;path&amp;gt; or&lt;br&gt;dev/&amp;lt;name&amp;gt; lock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875.0" y="554.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="lfb" value="ADOM lock&lt;br&gt;(fallback, logged)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875.0" y="674.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="ladom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="lscope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="lfb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="API key auth: a key lock (Postgres advisory lock; file lock off-box)&lt;br&gt;is taken first, on top of the scope above.&lt;br&gt;Every lock: retry every 1-10s, WARNING each minute while waiting,&lt;br&gt;INFO with the total wait once taken. -6 / -10 / -11 fail at once.&lt;br&gt;Run the call, commit, release in finally.&lt;br&gt;Installs and scripts: hold until the task finishes (next page)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#FFFDE7;strokeColor=#9E9D24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="860" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Hold until task" id="hold-until-task"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Installs and scripts: the lock outlives the RPC" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="840" height="40" as="geometry"/></mxCell><mxCell id="lane_conn" value="Connector" style="swimlane;html=1;startSize=44;fillColor=#E3F2FD;strokeColor=#1E88E5;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="280" height="704" as="geometry"/></mxCell><mxCell id="lane_fmg" value="FortiManager" style="swimlane;html=1;startSize=44;fillColor=#FCE4EC;strokeColor=#D81B60;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="280" height="704" as="geometry"/></mxCell><mxCell id="lane_db" value="Queued task" style="swimlane;html=1;startSize=44;fillColor=#EDE7F6;strokeColor=#5E35B1;fontStyle=1;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="280" height="704" as="geometry"/></mxCell><mxCell id="c0" value="Lock (ADOM / pkg / dev)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35.0" y="74.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="f0" value="Lock granted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315.0" y="74.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="c1" value="execute install/package,&lt;br&gt;install/device,&lt;br&gt;reinstall or script" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35.0" y="194.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="f1" value="Queue the task,&lt;br&gt;return task id&lt;br&gt;(status 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315.0" y="194.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="t2" value="Task copies config or&lt;br&gt;runs the script&lt;br&gt;(needs the lock)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#5E35B1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595.0" y="314.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="c3" value="Track the task until done&lt;br&gt;(even with Track Task off)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35.0" y="434.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="c4" value="Commit, unlock, log out;&lt;br&gt;return the task outcome" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;dashed=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35.0" y="554.0" width="210" height="76" as="geometry"/></mxCell><mxCell id="e0" value="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="f0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="exec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="state 4 / 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Before: the lock was released when the RPC returned.&lt;br&gt;The task then failed 'no write permission' (install) or&lt;br&gt;saved nothing (script) while the call still reported 0." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#FFFDE7;strokeColor=#9E9D24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Shared API key" id="shared-api-key"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="One API key = one FortiManager session: the connector serialises it" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1040" height="40" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;FortiSOAR node 1&lt;/b&gt;&lt;br&gt;playbook A, API key K" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="260" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;FortiSOAR node 2&lt;/b&gt;&lt;br&gt;playbook B, API key K" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="260" height="90" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Primary's Postgres&lt;/b&gt;&lt;br&gt;pg_try_advisory_lock(&lt;br&gt;hash(FMG, key, ADOM))&lt;br&gt;shared by every HA node" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE7F6;strokeColor=#5E35B1;fontSize=12;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="280" height="110" as="geometry"/></mxCell><mxCell id="fmg" value="&lt;b&gt;FortiManager&lt;/b&gt;&lt;br&gt;every request with K is&lt;br&gt;ONE session: either unlock&lt;br&gt;releases both" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=12;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="260" height="110" as="geometry"/></mxCell><mxCell id="ag" value="&lt;b&gt;Remote agent&lt;/b&gt;&lt;br&gt;no FortiSOAR DB: file lock,&lt;br&gt;this host only. Give each&lt;br&gt;agent its own key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#757575;fontSize=12;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="260" height="110" as="geometry"/></mxCell><mxCell id="e0" value="1. take key lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;e